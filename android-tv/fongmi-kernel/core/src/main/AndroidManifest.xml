<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <queries>
        <package android:name="com.fongmi.runtime.bdj" />
        <package android:name="com.fongmi.runtime.python" />
        <package android:name="com.fongmi.runtime.nodejs" />
        <package android:name="com.fongmi.runtime.quickjs" />
        <package android:name="com.fongmi.runtime.thunder" />
        <package android:name="com.fongmi.runtime.mpv" />
    </queries>
    <!-- HERRIN owns the launcher, Application and UI. Startup is explicitly
         called by the kernel Application, never installed in the legacy app. -->
    <application>
        <meta-data android:name="com.fongmi.runtime.catalog" android:value="${runtimeCatalog}" />
        <activity android:name="com.fongmi.android.tv.ui.activity.WebActivity" android:exported="false" android:theme="@style/Theme.App" />
        <service android:name="com.fongmi.android.tv.api.node.NodeService" android:exported="false" android:process=":nodejs" android:stopWithTask="true" />
    </application>
</manifest>
