<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Cleartext is needed by explicitly user-enabled TVBox CMS/Spider and loopback playback; version-1 licensed catalogs remain HTTPS-only. -->
    <application android:label="Herrin" android:icon="@mipmap/ic_launcher" android:banner="@drawable/tv_banner" android:theme="@style/Theme.Herrin" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Third-party Spider execution is isolated for crash containment, not a privilege sandbox. -->
        <service android:name=".TvBoxSpiderService" android:process=":spider"
            android:exported="false" android:stopWithTask="true" />
    </application>
</manifest>
